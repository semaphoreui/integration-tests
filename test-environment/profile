#!/bin/sh

set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repository_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)
profiles_dir="$script_dir/profiles"

usage() {
  cat <<'EOF'
Usage:
  test-environment/profile list
  test-environment/profile show <profile>
  test-environment/profile up <profile>
  test-environment/profile test <profile> [Gradle arguments]
  test-environment/profile upgrade-test <profile>
  test-environment/profile encryption-rotation-test <profile>
  test-environment/profile ps <profile>
  test-environment/profile logs <profile> [--follow]
  test-environment/profile down <profile>
  test-environment/profile clean <profile> --yes

down keeps database and fixture volumes. clean permanently removes them and
therefore requires the explicit --yes confirmation.

upgrade-test is available only for upgrade profiles. It recreates that profile's
isolated volumes, seeds data on N-1, switches the server image to current and
verifies the persisted data and task execution.

encryption-rotation-test is available only for encryption rotation profiles. It
creates data with the old primary key, hot-reloads a new primary, rekeys database
secrets, removes the retired key and verifies the persisted task fixture.
EOF
}

fail() {
  printf 'profile: %s\n' "$1" >&2
  exit 1
}

manifest_value() {
  key=$1
  sed -n "s/^${key}:[[:space:]]*//p" "$manifest_file" | sed -n '1p'
}

select_profile() {
  profile_id=$1
  case "$profile_id" in
    ''|*[!A-Za-z0-9._-]*) fail "invalid profile id: $profile_id" ;;
  esac

  profile_dir="$profiles_dir/$profile_id"
  manifest_file="$profile_dir/profile.yaml"
  [ -f "$manifest_file" ] || fail "unknown profile '$profile_id'; run 'test-environment/profile list'"

  compose_relative=$(manifest_value compose_file)
  compose_project=$(manifest_value compose_project)
  readiness_url=$(manifest_value readiness_url)
  stand=$(manifest_value stand)
  setup_service=$(manifest_value setup_service)
  selected_semaphore_image=$(manifest_value semaphore_image)
  selected_schedule_timezone=$(manifest_value schedule_timezone)
  [ -n "$selected_schedule_timezone" ] || selected_schedule_timezone=UTC
  selected_test_task=$(manifest_value test_task)
  [ -n "$selected_test_task" ] || selected_test_task=apiTest
  selected_test_class=$(manifest_value test_class)
  selected_api_base_url=$(manifest_value api_base_url)
  selected_ui_base_url=$(manifest_value ui_base_url)
  selected_ui_ignore_https_errors=$(manifest_value ui_ignore_https_errors)
  [ -n "$selected_ui_ignore_https_errors" ] || selected_ui_ignore_https_errors=false
  selected_tls_fixture=$(manifest_value tls_fixture)
  selected_encryption_fixture=$(manifest_value encryption_fixture)

  case "$selected_test_task" in
    apiTest|uiTest|totpTest|encryptionRotationTest) ;;
    *) fail "unsupported test_task '$selected_test_task' in $manifest_file" ;;
  esac

  [ -n "$compose_relative" ] || fail "compose_file is missing in $manifest_file"
  [ -n "$compose_project" ] || fail "compose_project is missing in $manifest_file"
  [ -n "$readiness_url" ] || fail "readiness_url is missing in $manifest_file"
  [ -n "$stand" ] || fail "stand is missing in $manifest_file"

  compose_dir=$(CDPATH= cd -- "$profile_dir/$(dirname -- "$compose_relative")" && pwd)
  compose_file="$compose_dir/$(basename -- "$compose_relative")"
  [ -f "$compose_file" ] || fail "Compose file does not exist: $compose_file"
}

compose() {
  SEMAPHORE_IMAGE="$selected_semaphore_image" \
    docker compose --project-name "$compose_project" --file "$compose_file" "$@"
}

wait_for_setup() {
  if [ -n "$setup_service" ]; then
    setup_container=$(compose ps --all --quiet "$setup_service")
    [ -n "$setup_container" ] || fail "profile setup service '$setup_service' has no container; run the up action first"

    setup_status=$(docker inspect --format '{{.State.Status}}' "$setup_container")
    if [ "$setup_status" != "exited" ]; then
      printf 'Waiting for profile setup service %s...\n' "$setup_service"
      setup_attempt=0
      while [ "$setup_status" != "exited" ] && [ "$setup_attempt" -lt 120 ]; do
        sleep 1
        setup_status=$(docker inspect --format '{{.State.Status}}' "$setup_container")
        setup_attempt=$((setup_attempt + 1))
      done
      [ "$setup_status" = "exited" ] \
        || fail "profile setup service '$setup_service' did not exit within 120 seconds"
    fi

    setup_exit_code=$(docker inspect --format '{{.State.ExitCode}}' "$setup_container")
    if [ "$setup_exit_code" -ne 0 ]; then
      compose logs --tail 100 "$setup_service" >&2 || true
      fail "profile setup service '$setup_service' exited with code $setup_exit_code"
    fi
  fi
}

await_ready() {
  attempt=0
  while [ "$attempt" -lt 60 ]; do
    if [ "$selected_tls_fixture" = "generated" ]; then
      readiness_response=$(curl --silent --show-error --max-time 2 --cacert "$tls_certificate" "$readiness_url" 2>/dev/null || true)
    else
      readiness_response=$(curl --silent --show-error --max-time 2 "$readiness_url" 2>/dev/null || true)
    fi
    if [ "$readiness_response" = "pong" ]; then
      printf 'Profile %s is ready at %s\n' "$profile_id" "$readiness_url"
      return 0
    fi
    attempt=$((attempt + 1))
    sleep 1
  done

  printf 'Profile %s did not become ready within 60 seconds.\n' "$profile_id" >&2
  compose ps >&2 || true
  compose logs --tail 100 >&2 || true
  return 1
}

configure_java() {
  if java -version >/dev/null 2>&1; then
    return
  fi

  macos_java_home=/opt/homebrew/opt/openjdk@21
  if [ -x "$macos_java_home/bin/java" ]; then
    JAVA_HOME=$macos_java_home
    export JAVA_HOME
    return
  fi

  fail "Java 21 is not available; set JAVA_HOME before running the test action"
}

prepare_ssh_fixture() {
  [ "$(manifest_value ssh_fixture_key)" = "generated" ] || return 0
  command -v ssh-keygen >/dev/null 2>&1 || fail "ssh-keygen is required for profile '$profile_id'"

  ssh_fixture_dir="$repository_dir/build/test-fixtures/ssh"
  mkdir -p "$ssh_fixture_dir"

  for ssh_key_name in id_ed25519 id_ed25519_rotated; do
    ssh_private_key="$ssh_fixture_dir/$ssh_key_name"
    ssh_public_key="$ssh_private_key.pub"
    if [ ! -s "$ssh_private_key" ] || [ ! -s "$ssh_public_key" ]; then
      if [ -e "$ssh_private_key" ] || [ -e "$ssh_public_key" ]; then
        fail "incomplete SSH fixture key pair for $ssh_key_name in $ssh_fixture_dir; remove both files and retry"
      fi
      if [ "$ssh_key_name" = "id_ed25519" ]; then
        ssh_key_passphrase='Bookwright-ssh-passphrase-42!'
      else
        ssh_key_passphrase='Bookwright-rotated-ssh-passphrase-42!'
      fi
      ssh-keygen -q -t ed25519 -a 16 \
        -N "$ssh_key_passphrase" \
        -C "bookwright-test-only-$ssh_key_name" \
        -f "$ssh_private_key"
    fi

    chmod 600 "$ssh_private_key"
    chmod 644 "$ssh_public_key"
  done
}

prepare_tls_fixture() {
  [ "$selected_tls_fixture" = "generated" ] || return 0
  command -v openssl >/dev/null 2>&1 || fail "openssl is required for profile '$profile_id'"
  configure_java

  tls_fixture_dir="$repository_dir/build/test-fixtures/proxy-tls"
  tls_private_key="$tls_fixture_dir/localhost-key.pem"
  tls_certificate="$tls_fixture_dir/localhost-cert.pem"
  tls_truststore="$tls_fixture_dir/localhost-truststore.p12"
  mkdir -p "$tls_fixture_dir"

  if [ ! -s "$tls_private_key" ] || [ ! -s "$tls_certificate" ]; then
    if [ -e "$tls_private_key" ] || [ -e "$tls_certificate" ]; then
      fail "incomplete TLS fixture in $tls_fixture_dir; remove the directory and retry"
    fi
    openssl req -x509 -newkey rsa:2048 -sha256 -days 3650 -nodes \
      -keyout "$tls_private_key" \
      -out "$tls_certificate" \
      -config "$profiles_dir/feature-proxy-oidc/openssl.cnf"
  fi

  chmod 600 "$tls_private_key"
  chmod 644 "$tls_certificate"

  if [ ! -s "$tls_truststore" ]; then
    if [ -n "${JAVA_HOME:-}" ]; then
      keytool_command="$JAVA_HOME/bin/keytool"
    else
      keytool_command=$(command -v keytool || true)
    fi
    [ -x "$keytool_command" ] || fail "keytool is required for profile '$profile_id'"
    "$keytool_command" -importcert -noprompt \
      -alias bookwright-proxy-localhost \
      -file "$tls_certificate" \
      -keystore "$tls_truststore" \
      -storetype PKCS12 \
      -storepass changeit
  fi
}

prepare_encryption_fixture() {
  [ "$selected_encryption_fixture" = "generated" ] || return 0
  command -v openssl >/dev/null 2>&1 || fail "openssl is required for profile '$profile_id'"

  encryption_fixture_dir="$repository_dir/build/test-fixtures/encryption-rotation"
  encryption_keys_dir="$encryption_fixture_dir/keys"
  encryption_keys_file="$encryption_fixture_dir/keys.yaml"
  old_encryption_key="$encryption_keys_dir/old-primary.key"
  new_encryption_key="$encryption_keys_dir/new-primary.key"
  mkdir -p "$encryption_keys_dir"

  if [ ! -s "$old_encryption_key" ]; then
    openssl rand -base64 -out "$old_encryption_key" 32
  fi
  if [ ! -s "$new_encryption_key" ]; then
    openssl rand -base64 -out "$new_encryption_key" 32
  fi
  # Disposable test keys are world-readable inside this isolated profile so the
  # host and the non-root container user can share the same bind mount on Linux/macOS.
  chmod 644 "$old_encryption_key" "$new_encryption_key"
}

write_encryption_keyset() {
  active_key=$1
  include_old_key=$2
  temporary_keys_file="$encryption_keys_file.tmp"

  {
    printf 'keys:\n'
    if [ "$include_old_key" = "true" ]; then
      printf '  old-primary:\n'
      printf '    file: /run/semaphore-encryption/keys/old-primary.key\n'
    fi
    printf '  new-primary:\n'
    printf '    file: /run/semaphore-encryption/keys/new-primary.key\n'
    printf 'active:\n'
    printf '  secret_key: %s\n' "$active_key"
    printf '  option_key: %s\n' "$active_key"
  } > "$temporary_keys_file"
  chmod 644 "$temporary_keys_file"
  mv "$temporary_keys_file" "$encryption_keys_file"
}

write_allure_environment() {
  allure_dir="$repository_dir/build/allure-results"
  mkdir -p "$allure_dir"

  image=$(manifest_value semaphore_image)
  image_reference=$(docker image inspect "$image" --format '{{index .RepoDigests 0}}' 2>/dev/null || true)
  [ -n "$image_reference" ] || image_reference=$image

  database_image=$(manifest_value database_image)
  database_image_reference=$database_image
  if [ "$database_image" != "embedded" ]; then
    inspected_database_image=$(docker image inspect "$database_image" --format '{{index .RepoDigests 0}}' 2>/dev/null || true)
    [ -z "$inspected_database_image" ] || database_image_reference=$inspected_database_image
  fi

  runner_image=$(manifest_value runner_image)
  runner_image_reference=$runner_image
  if [ -n "$runner_image" ]; then
    inspected_runner_image=$(docker image inspect "$runner_image" --format '{{index .RepoDigests 0}}' 2>/dev/null || true)
    [ -z "$inspected_runner_image" ] || runner_image_reference=$inspected_runner_image
  fi

  ssh_fixture_image=$(manifest_value ssh_fixture_image)
  ssh_fixture_image_reference=$ssh_fixture_image
  if [ -n "$ssh_fixture_image" ]; then
    inspected_ssh_fixture_image=$(docker image inspect "$ssh_fixture_image" --format '{{index .RepoDigests 0}}' 2>/dev/null || true)
    [ -z "$inspected_ssh_fixture_image" ] || ssh_fixture_image_reference=$inspected_ssh_fixture_image
  fi

  {
    printf 'profile=%s\n' "$profile_id"
    printf 'semaphore.version=%s\n' "$(manifest_value semaphore_version)"
    printf 'semaphore.image=%s\n' "$image_reference"
    printf 'semaphore.source.commit=%s\n' "$(manifest_value source_commit)"
    printf 'semaphore.edition=%s\n' "$(manifest_value edition)"
    printf 'installation=%s\n' "$(manifest_value installation)"
    printf 'architecture=%s\n' "$(uname -m)"
    printf 'database.type=%s\n' "$(manifest_value database_type)"
    printf 'database.image=%s\n' "$database_image_reference"
    printf 'execution.mode=%s\n' "$(manifest_value execution_mode)"
    printf 'execution.executor=%s\n' "$(manifest_value execution_executor)"
    printf 'schedule.timezone=%s\n' "$selected_schedule_timezone"
    if [ -n "$runner_image_reference" ]; then
      printf 'runner.image=%s\n' "$runner_image_reference"
      printf 'runner.name=%s\n' "$(manifest_value runner_name)"
    fi
    if [ -n "$ssh_fixture_image_reference" ]; then
      printf 'ssh.fixture.image=%s\n' "$ssh_fixture_image_reference"
    fi
    printf 'auth=%s\n' "$(manifest_value auth)"
    printf 'test.task=%s\n' "$selected_test_task"
    if [ -n "$selected_test_class" ]; then
      printf 'test.class=%s\n' "$selected_test_class"
    fi
    if [ -n "$selected_api_base_url" ]; then
      printf 'api.base.url=%s\n' "$selected_api_base_url"
    fi
    if [ -n "$selected_ui_base_url" ]; then
      printf 'ui.base.url=%s\n' "$selected_ui_base_url"
    fi
    if [ "$selected_tls_fixture" = "generated" ]; then
      printf 'tls.termination=reverse-proxy-self-signed\n'
    fi
    oidc_provider=$(manifest_value oidc_provider)
    if [ -n "$oidc_provider" ]; then
      printf 'auth.oidc.provider=%s\n' "$oidc_provider"
    fi
    oidc_image=$(manifest_value oidc_image)
    if [ -n "$oidc_image" ]; then
      oidc_image_reference=$(docker image inspect "$oidc_image" --format '{{index .RepoDigests 0}}' 2>/dev/null || true)
      [ -n "$oidc_image_reference" ] || oidc_image_reference=$oidc_image
      printf 'auth.oidc.image=%s\n' "$oidc_image_reference"
    fi
    ldap_image=$(manifest_value ldap_image)
    if [ -n "$ldap_image" ]; then
      ldap_image_reference=$(docker image inspect "$ldap_image" --format '{{index .RepoDigests 0}}' 2>/dev/null || true)
      [ -n "$ldap_image_reference" ] || ldap_image_reference=$ldap_image
      printf 'auth.ldap.image=%s\n' "$ldap_image_reference"
    fi
    proxy_image=$(manifest_value proxy_image)
    if [ -n "$proxy_image" ]; then
      proxy_image_reference=$(docker image inspect "$proxy_image" --format '{{index .RepoDigests 0}}' 2>/dev/null || true)
      [ -n "$proxy_image_reference" ] || proxy_image_reference=$proxy_image
      printf 'proxy.image=%s\n' "$proxy_image_reference"
    fi
    printf 'git.client=%s\n' "$(manifest_value git_client)"
    printf 'capabilities=%s\n' "$(manifest_value capabilities)"
    previous_image=$(manifest_value previous_semaphore_image)
    if [ -n "$previous_image" ]; then
      previous_image_reference=$(docker image inspect "$previous_image" --format '{{index .RepoDigests 0}}' 2>/dev/null || true)
      [ -n "$previous_image_reference" ] || previous_image_reference=$previous_image
      printf 'upgrade.from.version=%s\n' "$(manifest_value previous_semaphore_version)"
      printf 'upgrade.from.image=%s\n' "$previous_image_reference"
      printf 'upgrade.from.source.commit=%s\n' "$(manifest_value previous_source_commit)"
      printf 'upgrade.to.version=%s\n' "$(manifest_value semaphore_version)"
    fi
  } > "$allure_dir/environment.properties"
}

run_upgrade_phase() {
  phase=$1
  (
    cd "$repository_dir"
    ./gradlew upgradeTest \
      -DSTAND="$stand" \
      -DSEMAPHORE_PROFILE="$profile_id" \
      -DSEMAPHORE_SCHEDULE_TIMEZONE="$selected_schedule_timezone" \
      -DSEMAPHORE_UPGRADE_PHASE="$phase"
  )
}

run_encryption_rotation_phase() {
  phase=$1
  (
    cd "$repository_dir"
    ./gradlew encryptionRotationTest \
      -DSTAND="$stand" \
      -DSEMAPHORE_PROFILE="$profile_id" \
      -DSEMAPHORE_SCHEDULE_TIMEZONE="$selected_schedule_timezone" \
      -DSEMAPHORE_ENCRYPTION_ROTATION_PHASE="$phase"
  )
}

assert_vault_state() {
  output=$1
  expected=$2
  description=$3
  case "$output" in
    *"$expected"*) ;;
    *) fail "$description; expected vault output to contain '$expected'" ;;
  esac
}

action=${1:-}

case "$action" in
  list)
    for manifest_file in "$profiles_dir"/*/profile.yaml; do
      [ -f "$manifest_file" ] || continue
      profile_id=$(sed -n 's/^id:[[:space:]]*//p' "$manifest_file" | sed -n '1p')
      description=$(sed -n 's/^description:[[:space:]]*//p' "$manifest_file" | sed -n '1p')
      printf '%-24s %s\n' "$profile_id" "$description"
    done
    ;;
  show)
    select_profile "${2:-}"
    sed -n '1,240p' "$manifest_file"
    ;;
  up)
    select_profile "${2:-}"
    prepare_ssh_fixture
    prepare_tls_fixture
    prepare_encryption_fixture
    if [ "$selected_encryption_fixture" = "generated" ] && [ ! -s "$encryption_keys_file" ]; then
      write_encryption_keyset old-primary true
    fi
    compose up --detach
    wait_for_setup
    await_ready
    ;;
  test)
    select_profile "${2:-}"
    [ "$selected_encryption_fixture" != "generated" ] \
      || fail "profile '$profile_id' requires: test-environment/profile encryption-rotation-test $profile_id"
    shift 2
    prepare_ssh_fixture
    prepare_tls_fixture
    prepare_encryption_fixture
    wait_for_setup
    await_ready
    configure_java
    write_allure_environment
    (
      cd "$repository_dir"
      set -- "$selected_test_task" \
        "-DSTAND=$stand" \
        "-DSEMAPHORE_PROFILE=$profile_id" \
        "-DSEMAPHORE_SCHEDULE_TIMEZONE=$selected_schedule_timezone" \
        "-Dui.ignore.https.errors=$selected_ui_ignore_https_errors" \
        "$@"
      if [ -n "$selected_api_base_url" ]; then
        set -- "$@" "-Dapi.base.url=$selected_api_base_url"
      fi
      if [ -n "$selected_ui_base_url" ]; then
        set -- "$@" "-Dui.base.url=$selected_ui_base_url"
      fi
      if [ "$selected_tls_fixture" = "generated" ]; then
        set -- "$@" \
          "-Dbookwright.test.ssl.trustStore=$tls_truststore" \
          "-Dbookwright.test.ssl.trustStorePassword=changeit"
      fi
      if [ -n "$selected_test_class" ]; then
        set -- "$@" --tests "$selected_test_class"
      fi
      ./gradlew "$@"
    )
    ;;
  upgrade-test)
    select_profile "${2:-}"
    previous_semaphore_image=$(manifest_value previous_semaphore_image)
    [ -n "$previous_semaphore_image" ] || fail "profile '$profile_id' does not define previous_semaphore_image"
    configure_java

    compose down --volumes --remove-orphans
    selected_semaphore_image=$previous_semaphore_image
    compose up --detach
    wait_for_setup
    await_ready
    run_upgrade_phase seed

    selected_semaphore_image=$(manifest_value semaphore_image)
    compose up --detach --force-recreate semaphore
    await_ready
    write_allure_environment
    if ! run_upgrade_phase verify; then
      compose logs --tail 120 semaphore >&2 || true
      fail "upgrade verification failed for '$profile_id'; current containers and volumes were retained for diagnosis"
    fi
    (
      cd "$repository_dir"
      ./gradlew apiTest \
        -DSTAND="$stand" \
        -DSEMAPHORE_PROFILE="$profile_id" \
        -DSEMAPHORE_SCHEDULE_TIMEZONE="$selected_schedule_timezone"
    )
    ;;
  encryption-rotation-test)
    select_profile "${2:-}"
    [ "$selected_encryption_fixture" = "generated" ] \
      || fail "profile '$profile_id' does not define encryption_fixture: generated"
    configure_java
    prepare_encryption_fixture

    compose down --volumes --remove-orphans
    write_encryption_keyset old-primary true
    compose up --detach
    wait_for_setup
    await_ready
    run_encryption_rotation_phase seed

    write_encryption_keyset new-primary true
    sleep 2
    run_encryption_rotation_phase rotated

    vault_before_rekey=$(compose exec -T semaphore semaphore vault check)
    printf '%s\n' "$vault_before_rekey"
    assert_vault_state "$vault_before_rekey" "retired, rekey pending" \
      "vault check did not find data encrypted by the retired key"
    assert_vault_state "$vault_before_rekey" "1 rows — active" \
      "vault check did not find the secret written by the new active key"
    retired_key_id=$(
      printf '%s\n' "$vault_before_rekey" \
        | sed -n 's/^  \([^:]*\): [0-9][0-9]* rows — retired, rekey pending$/\1/p' \
        | sed -n '1p'
    )
    [ -n "$retired_key_id" ] || fail "vault check did not expose the retired key id"

    compose exec -T semaphore semaphore vault rekey --backup /tmp/bookwright-rekey-backup.jsonl
    vault_after_rekey=$(compose exec -T semaphore semaphore vault check)
    printf '%s\n' "$vault_after_rekey"
    assert_vault_state "$vault_after_rekey" "$retired_key_id: 0 rows — retired, SAFE TO REMOVE" \
      "vault check did not declare key $retired_key_id safe to remove"
    assert_vault_state "$vault_after_rekey" "2 rows — active" \
      "vault rekey did not move both secrets to the active key"

    write_encryption_keyset new-primary false
    sleep 2
    vault_without_retired=$(compose exec -T semaphore semaphore vault check)
    printf '%s\n' "$vault_without_retired"
    assert_vault_state "$vault_without_retired" "2 rows — active" \
      "vault check failed after the retired key was removed"
    write_allure_environment
    if ! run_encryption_rotation_phase verify; then
      compose logs --tail 120 semaphore >&2 || true
      fail "encryption rotation verification failed for '$profile_id'; containers and volumes were retained for diagnosis"
    fi
    ;;
  ps)
    select_profile "${2:-}"
    compose ps
    ;;
  logs)
    select_profile "${2:-}"
    case "${3:-}" in
      '') compose logs --no-color --timestamps ;;
      --follow) compose logs --no-color --timestamps --follow ;;
      *) fail "unknown logs option '${3:-}'; use --follow or omit it" ;;
    esac
    ;;
  down)
    select_profile "${2:-}"
    compose down --remove-orphans
    ;;
  clean)
    select_profile "${2:-}"
    [ "${3:-}" = "--yes" ] || fail "clean removes profile volumes; repeat with: test-environment/profile clean $profile_id --yes"
    compose down --volumes --remove-orphans
    ;;
  help|-h|--help|'')
    usage
    ;;
  *)
    usage >&2
    fail "unknown action: $action"
    ;;
esac
